{
  "name": "hidemyemail-worker",
  "version": "1.4.0",
  "description": "Cloudflare Worker for HideMyEmail alias service",
  "author": "Tilian Burger",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "vitest run --exclude test/validate-release.test.mjs && vitest run --config vitest.validator.config.mjs",
    "test:watch": "vitest",
    "deploy": "wrangler deploy --env=\"\" --keep-vars",
    "deploy:preview": "wrangler deploy --env preview --keep-vars",
    "migrate:prod": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "predeploy": "npm run migrate:prod",
    "predeploy:preview": "npm run migrate:preview",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.5",
    "mimetext": "^3.0.28",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "sharp": "0.35.3"
  }
}
