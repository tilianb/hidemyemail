# Copy to docker/.env and fill in.
# `docker compose` auto-loads docker/.env when run from the docker/ folder, or
# pass with --env-file. NEVER commit the populated file.

# ─── Image / network ─────────────────────────────────────────────────────────
# Docker Hub is the default image. Set IMAGE=ghcr.io/tilianb/hidemyemail to use GHCR.
# IMAGE=docker.io/tilianb/hidemyemail

# Pin a specific release here, otherwise the compose file defaults to :latest.
# Docker Hub publishes release tags only: latest, vX.Y.Z, vX.Y, vX.
# GHCR also publishes main and sha-<short> tags.
# IMAGE_TAG=v1.2.3

# Default is "missing" (only pull if not present locally). Set to "always" to
# force a pull on every `up`, or "never" if you build from source.
# PULL_POLICY=missing

# Host port the container's 8787 maps to on 127.0.0.1. Do not publish it on a
# public interface; put a reverse proxy (Caddy/nginx) in front for TLS.
# HOST_PORT=8787

# Comma-separated exact socket peer IPs allowed to set
# X-HideMyEmail-Client-IP. Leave empty for direct loopback-only access. If a
# reverse proxy is used, list only its address and configure it to OVERWRITE
# (never append/forward) that header with the connecting client's IP.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# ─── Worker runtime ───────────────────────────────────────────────────────────
# Defaults to self-hosted.
# ENVIRONMENT=self-hosted
# Optional comma-separated exact DNS labels unavailable for new personal
# subdomain claims. Matching is case-insensitive; wildcards are not supported.
# BLOCKED_SUBDOMAINS=admin,api,www
# Canonical public dashboard origin and WebAuthn RP origin. Use the exact
# browser-visible HTTPS origin (including a non-default port): no path, query,
# fragment, credentials, or trailing slash. HTTP is accepted only for loopback
# development. Passkeys remain disabled when this value is absent.
APP_ORIGIN=https://app.example.com
# Comma-separated strict Android WebAuthn APK origins. Each value embeds the
# base64url SHA-256 signing-certificate digest and also drives assetlinks.json.
# ANDROID_APP_ORIGINS=android:apk-key-hash:base64url-sha256-certificate-digest
# Bump only if you also rebuild against a newer Miniflare/workerd.
# COMPATIBILITY_DATE=2026-05-01

# ─── AWS SES / S3 / SNS ───────────────────────────────────────────────────────
# Receiving and sending are independent. Existing installations keep SES for
# both unless these values are changed in .env or Admin settings.
# MAIL_INBOUND_PROVIDER=ses       # ses | builtin | gateway
# MAIL_OUTBOUND_PROVIDER=ses
# Canonical DNS hostname for built-in receiving or direct sending.
# MAIL_HOSTNAME=mail.example.com
# Self-hosting the Worker still leaves the mail pipeline on AWS. You need:
#   - SES domain identity + DKIM verified
#   - Receipt rule that stores raw MIME in S3_INBOUND_BUCKET
#   - SNS topic with HTTPS subscription pointing at https://your-host/api/ses/inbound
#   - IAM keypair with ses:SendRawEmail + s3:GetObject on the bucket
SES_REGION=ap-southeast-2
S3_INBOUND_BUCKET=hidemyemail-inbound-raw
SES_ACCESS_KEY_ID=AKIA...
SES_SECRET_ACCESS_KEY=...

# Exact SNS topic ARNs used after AWS signature verification. Each endpoint
# returns a configuration error when its ARN is blank. There is no SNS_SECRET.
SNS_INBOUND_TOPIC_ARN=arn:aws:sns:ap-southeast-2:000000000000:hidemyemail-inbound
SNS_ALLOWED_TOPIC_ARN=arn:aws:sns:ap-southeast-2:000000000000:hidemyemail-outbound

# ─── Custom SMTP outbound (Docker only, optional) ─────────────────────────────
# MAIL_OUTBOUND_PROVIDER=smtp
# Public gateway MX and supplier SPF include (empty keeps SES defaults).
# INBOUND_MX_HOST=mx.gateway.example
# OUTBOUND_SPF_INCLUDE=spf.relay.example
# SMTP_OUTBOUND_HOST=smtp.example.com
# SMTP_OUTBOUND_PORT=587
# SMTP_OUTBOUND_TLS=starttls       # starttls | implicit | trusted-cleartext
# SMTP_OUTBOUND_USERNAME=
# SMTP_OUTBOUND_PASSWORD=
# SMTP_OUTBOUND_TLS_SERVERNAME=    # required when HOST is an IP
# `trusted-cleartext` is accepted only for an explicitly trusted port-25 relay.
# Certificate verification cannot be disabled.

# Direct delivery is also available when the host permits OUTBOUND TCP 25:
# MAIL_OUTBOUND_PROVIDER=direct
# It needs MAIL_HOSTNAME, matching forward/reverse DNS, SPF authorizing the
# server IP, and the DKIM TXT records shown in Admin after restart. If your host
# blocks outbound 25, use provider SMTP on 587/STARTTLS or 465/TLS instead.

# ─── Built-in SMTP receiving (Docker only, optional) ──────────────────────────
# Receive Internet mail directly: set these values and start with the mail
# Compose overlay documented in docker/README.md. Your firewall and provider
# must permit INBOUND TCP 25. Outbound port 25 is not required when forwarding
# through SES or provider SMTP.
# MAIL_INBOUND_PROVIDER=builtin
# MAIL_HOSTNAME=mail.example.com
# SMTP_INBOUND_HOST=0.0.0.0
# SMTP_INBOUND_PORT=2525
# SMTP_INBOUND_MAX_BYTES=26214400
# MAIL_QUEUE_MAX_BYTES=1073741824
# RSPAMD_URL=http://rspamd:11333/checkv2
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# Optional public STARTTLS certificate files mounted into the app container:
# SMTP_INBOUND_TLS_CERT=/run/secrets/smtp-cert.pem
# SMTP_INBOUND_TLS_KEY=/run/secrets/smtp-key.pem

# ─── Trusted SMTP ingress (Docker only, optional) ─────────────────────────────
# Advanced alternative: receive from an independently operated Stalwart/Maddy
# gateway. It is not an IMAP/POP login.
# MAIL_INBOUND_PROVIDER=gateway
# SMTP_INBOUND_ENABLED=false
# SMTP_INBOUND_HOST=127.0.0.1
# SMTP_INBOUND_PORT=2525
# SMTP_INBOUND_TLS=starttls        # starttls | implicit
# SMTP_INBOUND_USERNAME=
# SMTP_INBOUND_PASSWORD=
# SMTP_INBOUND_GATEWAY_ID=stalwart-1
# SMTP_INBOUND_TRUSTED_PEERS=127.0.0.1,::1
# SMTP_INBOUND_MAX_BYTES=26214400
# Non-loopback listeners require deployment-managed certificate files:
# SMTP_INBOUND_TLS_CERT=/run/secrets/smtp-cert.pem
# SMTP_INBOUND_TLS_KEY=/run/secrets/smtp-key.pem

# ─── iOS push notifications (optional) ────────────────────────────────────────
# APNs token-based auth for the iOS app. Leave blank to disable push (device
# registration still works; nothing is sent). APNS_TEAM_ID / APNS_BUNDLE_ID are
# derived from APPLE_APP_ID ("<TeamID>.<bundleId>") when left unset.
# APPLE_APP_ID=ABCDE12345.dev.hidemyemail.app
# APNS_KEY_ID=ABCD123456
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# Use api.sandbox.push.apple.com for development-signed builds.
# APNS_HOST=
# Contents of the AuthKey_XXXXXXXXXX.p8 (full PEM). Treat as a secret.
# APNS_AUTH_KEY=

# ─── Android push notifications (optional) ────────────────────────────────────
# FCM HTTP v1 for the Android app. Leave blank to disable Android push (device
# registration still works; nothing is sent). Full Firebase service-account
# JSON on one line; treat as a secret. FCM_PROJECT_ID defaults to its project_id.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# ─── App secrets ──────────────────────────────────────────────────────────────
# Generate fresh values per install:
#   SESSION_SECRET=$(openssl rand -hex 32)
#   DESTINATION_ENCRYPTION_KEY=$(openssl rand -base64 32)   # base64, NOT hex — AES needs exactly 32 bytes
#   AUTH_PASSWORD_SALT=$(openssl rand -hex 16)
#   AUTH_PASSWORD_HASH=$(node worker/scripts/hash-password.mjs <password> <salt>)
SESSION_SECRET=
AUTH_PASSWORD_HASH=
AUTH_PASSWORD_SALT=
DESTINATION_ENCRYPTION_KEY=
# Signs one-click unsubscribe links (optional — falls back to SESSION_SECRET;
# set it separately so rotating sessions doesn't invalidate unsubscribe links)
# ACTION_SECRET=
